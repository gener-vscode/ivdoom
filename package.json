{
    "name": "ivdoom",
    "version": "1.0.0",
    "description": "DOOM run in Node.js: the engine is ozkl/doomgeneric built here with our dg_stdio.c shim as .gener/build/doom/doom-headless (a child process of this Node process, playing freedoom1.wad); the picture goes to a real Pixoo 64 panel and the controls come from a phone virtual-controller PWA. ONE Node process for the page, the input broker, the status-strip cache, the panel supply loop and the engine.",
    "license": "UNLICENSED",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
                "kill": "lsof -ti:8043 -ti:8000 | xargs -r kill -9",
        "engine": "git clone --depth 1 https://github.com/ozkl/doomgeneric .gener/vendor/doomgeneric && make -C scripts/doom -j8",
        "engine:build": "make -C scripts/doom -j8",
        "cert": "node scripts/make-dev-cert.cjs",
        "serve": "yarn build && node scripts/doom-device.cjs --host-only",
        "host:check": "yarn build && node scripts/host-check.cjs",
                "canary": "node scripts/canary.cjs",
                "device": "node scripts/device-config.cjs",
        "play": "yarn build && node scripts/doom-device.cjs --input remote --warm --hold --seconds 0 --warp 2 1 --push 64",
        "play:32": "yarn build && node scripts/doom-device.cjs --input remote --warm --hold --seconds 0 --warp 21 --push 32",
        "play:demo": "yarn build && node scripts/doom-device.cjs --warm --hold --seconds 30 --push 64,32",
        "print-argv": "node scripts/doom-device.cjs --input remote --print-argv",
        "hid:selftest": "yarn build && node scripts/hid-selftest.cjs",
        "ui:install-check": "node scripts/chrome-install-check.cjs",
        "doom:keys-check": "yarn build && node scripts/doom-keys-check.cjs",
        "doom:warp-check": "node scripts/doom-warp-args-check.cjs",
        "doom:input-check": "node scripts/doom-input-check.cjs",
        "doom:tap-check": "node scripts/doom-tap-check.cjs",
        "doom:stages": "node scripts/doom-stage-probe.cjs",
        "doom:preview": "node scripts/doom-preview.cjs",
        "doom:gif": "node scripts/doom-gif.cjs",
        "demo:gif": "yarn build && node scripts/doom-gif.cjs --groups 1 --frames 1440 --gif-ms 60000 --size 64 --no-border --loop 0 --prefix doom-demo-60s-24fps --skip-s 3 --install assets"
    },
    "dependencies": {
        "@codepunkt/wasm-layout-text": "^3.0.0",
        "pngjs": "^7.0.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/pngjs": "^6.0.5",
        "typescript": "^5.7.2"
    }
}