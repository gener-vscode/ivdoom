{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "./src",
    "sourceMap": true,
    "listFiles": false,
    "strict": false,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  },
  "exclude": [
    "node_modules",
    "cloudflare-worker"
  ]
}